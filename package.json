{
  "name": "dsh-bootvideo",
  "version": "1.2.0",
  "private": true,
  "description": "Full-screen boot animation for the DeepSeek Harness Web GUI: plays a bundled clip on startup, then hands off to the workspace.",
  "type": "module",
  "license": "MIT",
  "author": "Stellato",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/StellatoL/dsh-bootvideo.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "boot-animation",
    "splash"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "media/boot.mp4",
    "media/boot.webm",
    "media/poster.jpg",
    "media/poster.webp",
    "media/curtain.jpg",
    "media/README.md",
    "scripts",
    "test",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "media": "node scripts/build-media.mjs",
    "media:manifest": "SKIP_ENCODE=1 node scripts/build-media.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
